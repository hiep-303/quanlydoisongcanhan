# ==========================================
# CẤU HÌNH HỆ THỐNG QUẢN LÝ ĐỜI SỐNG CÁ NHÂN
# ==========================================

# Môi trường chạy (development | production)
NODE_ENV=development

# Cổng dịch vụ Backend
PORT=5000

# Khóa bí mật ký mã thông báo JWT
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Đường dẫn tệp cơ sở dữ liệu SQLite
DB_PATH=./data/app.db

# Khóa API trí tuệ nhân tạo (Tùy chọn: Gemini API hoặc OpenAI)
# Nếu để trống, hệ thống tự động sử dụng bộ phân tích thông minh nội bộ dựa trên dữ liệu thật của bạn (Chế độ Demo / Local AI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# URL Frontend (dùng cho CORS)
CLIENT_URL=http://localhost:5173
